# Copy to build.env and fill in. The Cell SDK runs on a Windows machine reachable over ssh; these say which
# one and with what key, and where finished packages should land.
PS3_BUILD_VM="user@your-build-vm"
PS3_BUILD_KEY="$HOME/.ssh/your_key"
PS3_PKG_DIR="$HOME/ps3-packages"

# Optional. ssh port of the VM, when it is reached through a port forward rather than its own address.
#PS3_BUILD_PORT=2222

# Optional. A machine to hop through when the VM is only reachable from there - the old Windows VM on the
# Linux PC, from the Mac, for instance. Any ssh destination: user@host or user@host:port.
#PS3_BUILD_JUMP="tee@linux-pc"

# Optional. The upstream commit to build on. Leave it unset unless moving to a newer upstream on purpose -
# see UPSTREAM_REV in tools/build-env.sh for why it is pinned.
#PS3_UPSTREAM_REV="eb4be76fd89866e4dfbcfadc0b2eced3337c014b"
